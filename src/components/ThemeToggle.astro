---
---
<div class="theme-selector" id="theme-selector">
  <button id="theme-toggle" class="theme-toggle" aria-label="Theme settings" aria-expanded="false">
    <div class="icon-wrapper">
      <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg class="system-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
    </div>
    <span class="theme-label" id="theme-label">Dark</span>
  </button>
  
  <ul class="theme-menu" id="theme-menu" role="menu">
    <li>
      <button class="theme-option" data-theme-value="light" role="menuitem">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        Light
      </button>
    </li>
    <li>
      <button class="theme-option" data-theme-value="dark" role="menuitem">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        Dark
      </button>
    </li>
    <li>
      <button class="theme-option" data-theme-value="system" role="menuitem">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
        System
      </button>
    </li>
  </ul>
</div>

<style>
  .theme-selector {
    position: relative;
    display: inline-block;
  }

  .theme-toggle {
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, padding 0.3s ease;
    min-height: 40px;
  }
  
  .theme-toggle:hover,
  .theme-selector.is-open .theme-toggle {
    background-color: var(--card-bg);
    padding: 0.5rem 1rem 0.5rem 0.75rem;
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-wrapper svg {
    display: none;
  }

  /* Show appropriate icon based on current root data-theme-preference */
  :root[data-theme-preference="dark"] .moon-icon { display: block; }
  :root[data-theme-preference="light"] .sun-icon { display: block; }
  :root[data-theme-preference="system"] .system-icon { display: block; }
  :root:not([data-theme-preference]) .moon-icon { display: block; } /* Fallback */

  .theme-label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 0.3s ease, opacity 0.3s ease, margin-left 0.3s ease;
    font-weight: 600;
    font-size: 0.9rem;
    margin-left: 0;
  }

  .theme-toggle:hover .theme-label,
  .theme-selector.is-open .theme-label {
    max-width: 100px;
    opacity: 1;
    margin-left: 8px;
  }

  /* Dropdown Menu */
  .theme-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    background: var(--bg-color);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 0.5rem;
    list-style: none;
    min-width: 150px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 1000;
  }

  .theme-selector.is-open .theme-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .theme-option {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: var(--text-primary);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .theme-option:hover {
    background-color: var(--card-bg);
  }

  .theme-option.is-active {
    color: var(--accent-color);
  }
</style>

<script is:inline>
  const selector = document.getElementById('theme-selector');
  const toggleBtn = document.getElementById('theme-toggle');
  const label = document.getElementById('theme-label');
  const options = document.querySelectorAll('.theme-option');
  
  function getPreference() {
    return localStorage.getItem('theme-preference') || 'dark';
  }
  
  function setPreference(theme) {
    localStorage.setItem('theme-preference', theme);
    reflectPreference(theme);
  }
  
  function capitalize(str) {
    return str.charAt(0).toUpperCase() + str.slice(1);
  }
  
  function reflectPreference(theme) {
    document.documentElement.setAttribute('data-theme-preference', theme);
    label.textContent = capitalize(theme);
    
    // Update active state in menu
    options.forEach(opt => {
      if (opt.getAttribute('data-theme-value') === theme) {
        opt.classList.add('is-active');
      } else {
        opt.classList.remove('is-active');
      }
    });
    
    if (theme === 'system') {
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', systemDark ? 'dark' : 'light');
    } else {
      document.documentElement.setAttribute('data-theme', theme);
    }
  }
  
  // Set initial state
  reflectPreference(getPreference());
  
  // Listen for system changes if system is selected
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (getPreference() === 'system') {
      document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
    }
  });
  
  // Toggle menu open/close
  toggleBtn.addEventListener('click', () => {
    const isOpen = selector.classList.contains('is-open');
    if (isOpen) {
      selector.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
    } else {
      selector.classList.add('is-open');
      toggleBtn.setAttribute('aria-expanded', 'true');
    }
  });
  
  // Handle option clicks
  options.forEach(opt => {
    opt.addEventListener('click', () => {
      const value = opt.getAttribute('data-theme-value');
      setPreference(value);
      selector.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
    });
  });
  
  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (!selector.contains(e.target) && selector.classList.contains('is-open')) {
      selector.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
    }
  });
</script>
